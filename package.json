{
  "name": "net119-interconnect",
  "version": "1.0.0",
  "description": "NET119 相互接続システム - TS-1022準拠 STOMP 1.2 Gateway",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:web": "node dist/web-server.js",
    "start:caller": "node dist/caller-gateway.js",
    "start:callee": "node dist/callee-gateway.js",
    "start:broker": "node dist/stomp-broker.js",
    "dev": "ts-node src/index.ts",
    "dev:web": "ts-node src/web-server.ts",
    "dev:caller": "ts-node src/caller-gateway.ts",
    "dev:callee": "ts-node src/callee-gateway.ts",
    "dev:broker": "ts-node src/stomp-broker.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "cert:generate": "bash scripts/generate-certs.sh"
  },
  "keywords": [
    "net119",
    "stomp",
    "emergency",
    "119",
    "ts-1022"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@stomp/stompjs": "^7.0.0",
    "stompit": "^1.0.0",
    "ws": "^8.16.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
