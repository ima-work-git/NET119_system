# NET119 相互接続システム 環境変数設定例

# サーバー設定
STOMP_PORT=61614
WSS_PORT=443
BIND_HOST=0.0.0.0

# 固定IP（OCI Reserved Public IP）
PUBLIC_IP=

# TLS証明書
TLS_CERT_PATH=/etc/net119/certs/fullchain.pem
TLS_KEY_PATH=/etc/net119/certs/privkey.pem
TLS_CA_PATH=

# 開発用: TLS無効化
# DISABLE_TLS=true

# 事業者設定
OPERATOR_CODE=tokyo

# 事業者一覧（JSON形式）
# OPERATORS_CONFIG=[{"code":"tokyo","name":"東京消防庁","allowedIPs":["203.0.113.0/24"]}]

# STOMP設定
HEARTBEAT_INTERVAL=30000
CONNECT_TIMEOUT=10000
RECONNECT_INTERVAL=5000
MAX_RECONNECT_ATTEMPTS=10
MAX_MESSAGE_SIZE=65536

# ログ設定
LOG_LEVEL=info
LOG_JSON=true

# ブローカー接続（Caller/Callee Gateway用）
BROKER_HOST=localhost
BROKER_PORT=61614
